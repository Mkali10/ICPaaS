ICPAAAS_API_URL=https://control.example.com
ICPAAAS_NODE_KEY=replace-with-the-same-node-key-as-the-api
ICPAAAS_RECORDING_DIR=/var/lib/icpaas/recordings
ICPAAAS_RECORDING_ARCHIVE_DIR=/var/lib/icpaas/recordings/.uploaded
ICPAAAS_RECORDING_FAILED_DIR=/var/lib/icpaas/recordings/.failed
ICPAAAS_RECORDING_MIN_AGE_SECONDS=15
ICPAAAS_RECORDING_MAX_ATTEMPTS=10
